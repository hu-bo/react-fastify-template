{
  "name": "react-fastify-template",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @react-fastify-template/api dev",
    "build": "pnpm --filter @react-fastify-template/database build && pnpm --filter @react-fastify-template/api build",
    "start": "pnpm --filter @react-fastify-template/api start",
    "lint": "pnpm --filter @react-fastify-template/api lint && pnpm --filter @react-fastify-template/database lint",
    "typecheck": "pnpm --filter @react-fastify-template/database typecheck && pnpm --filter @react-fastify-template/api typecheck",
    "db:generate": "pnpm --filter @react-fastify-template/database db:generate",
    "db:migrate": "pnpm --filter @react-fastify-template/database db:migrate",
    "openapi:export": "pnpm --filter @react-fastify-template/database build && pnpm --filter @react-fastify-template/api openapi:export",
    "compose:up": "docker compose -f deploy/compose/compose.yaml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
