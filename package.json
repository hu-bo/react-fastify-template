{
  "name": "react-fastify-template",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @react-fastify-template/app-web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @react-fastify-template/app-server start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "pnpm --filter @react-fastify-template/app-server build && node scripts/smoke.mjs",
    "check": "pnpm openapi:export && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm --filter @react-fastify-template/app-web api:check",
    "db:generate": "pnpm --filter @react-fastify-template/app-server db:generate",
    "db:migrate": "pnpm --filter @react-fastify-template/app-server db:migrate",
    "openapi:export": "pnpm --filter @react-fastify-template/app-server openapi:export",
    "compose:up": "docker compose -f deploy/compose.yaml up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "prettier": "^3.6.2"
  }
}
